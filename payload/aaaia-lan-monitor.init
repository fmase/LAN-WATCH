#!/bin/sh /etc/rc.common
# Start the scanner and dashboard as separate procd instances.
START=99
STOP=10
USE_PROCD=1
start_service() {
 unset LAN_PORT
 . /etc/aaaia-lan-monitor.conf
 LAN_PORT=${LAN_PORT-59876}
 case "$LAN_PORT" in ''|0*|*[!0-9]*|??????*) echo 'Invalid LAN_PORT' >&2; return 1;; esac
 [ "$LAN_PORT" -ge 1024 ] && [ "$LAN_PORT" -le 65535 ] || { echo 'Invalid LAN_PORT' >&2; return 1; }
 procd_open_instance monitor
 procd_set_param command /usr/lib/aaaia-lan-monitor/monitor.sh "$LAN_DEVICE" "$LAN_PREFIX" /root/lan-monitor-data "$LAN_DNS"
 procd_set_param respawn 3600 10 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
 procd_open_instance web
 procd_set_param command /usr/sbin/uhttpd -f -c /dev/null -p "$LAN_IP:$LAN_PORT" -h /usr/lib/aaaia-lan-monitor/www -x /cgi-bin
 procd_set_param respawn 3600 10 5
 procd_close_instance
}
